# Cache policy snippet — applied via `import cache_policy` in each site block.
# Build outputs (content-hashed by Vite/Next/Nuxt/CRA) get year-long immutable cache.
# Everything else (HTML, SPA routes, /boot, /healthz) is never cached at edge or browser
# so deploys take effect immediately. `defer` makes these headers win over upstream.
(cache_policy) {
	@build_assets path /assets/* /_next/static/* /_nuxt/* /static/js/* /static/css/* /static/media/*
	header @build_assets {
		Cache-Control "public, max-age=31536000, immutable"
		defer
	}

	@uncached not path /assets/* /_next/static/* /_nuxt/* /static/js/* /static/css/* /static/media/*
	header @uncached {
		Cache-Control "no-store, must-revalidate"
		CDN-Cache-Control "no-store"
		defer
	}
}

# The t3 gateway's FIT engine (t3-gateway, spec 035) is served under /fit on the
# gateway's own port. Django reaches it over the docker network, never through
# Caddy; through Caddy, only the devel server itself may. client_ip is the real
# client behind Cloudflare (trusted_proxies above). Set to the devel server's public IP.
(fit_same_host) {
	@fit_foreign {
		path /fit /fit/*
		not client_ip 100.78.132.23
	}
	respond @fit_foreign "Forbidden" 403
}

import "*.Caddyfile"
